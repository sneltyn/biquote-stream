NODE_ENV=development
APP_NAME=biquote-stream

# ── biquote ──────────────────────────────────────────────────────────────
# Anonymous SignalR hub — no key. Free, no SLA, access can be withdrawn.
BIQUOTE_HUB_URL=https://biquote.io/hubs/tick

# Subscription set, our slash form ("EUR/USD"). The image ships 10 majors;
# mount the real list over it in deploy.
FOREX_PAIRS_FILE=pairs.forex.json

# Our symbol → biquote's, for every symbol that is NOT the six letters without
# the slash. A wrong name does not throw — it simply never ticks, and the stats
# line lists it under never_ticked.
# SYMBOL_OVERRIDES={"XAU/USD":"XAUUSD","NAS100/USD":"USTEC"}

# ── NATS ─────────────────────────────────────────────────────────────────
NATS_SERVERS=nats://127.0.0.1:4222
NATS_NAME=biquote-stream
# NATS_USER=
# NATS_PASSWORD=
# NATS_TOKEN=
# NATS_CREDS_FILE=
NATS_RECONNECT_WAIT_MS=2000
NATS_RECONNECT_JITTER_MS=500
NATS_PUBLISH_TIMEOUT_MS=5000

# THE LAST TOKEN NAMES THE VENDOR. coins must know `biquote` before this
# service starts — an unknown token is let through and interleaves with the
# selected vendor.
NATS_SUBJECT_FOREX=prices.forex.biquote

NATS_STREAM_NAME=PRICES
NATS_STREAM_SUBJECTS=prices.>
NATS_STREAM_MAX_AGE_MS=300000
NATS_STREAM_MAX_BYTES=1073741824
NATS_STREAM_REPLICAS=1

# ── Liveness ─────────────────────────────────────────────────────────────
# Whole-feed silence on a connected hub this long → reconnect. A reconnect
# that brings nothing back (weekend close) doubles the delay up to the max.
STALE_TIMEOUT_MS=60000
STALE_CHECK_INTERVAL_MS=15000
RECONNECT_MIN_MS=5000
RECONNECT_MAX_MS=600000
STATS_INTERVAL_MS=60000

# Feed age (arrival − vendor stamp) at which the stats line becomes a WARN.
LAG_WARN_MS=3000
